 }
 #define check(value, ...) check_func(value, __LINE__, __VA_ARGS__)
 
+static void test_avif_rejects_nonkey_first_packet(void)
+{
+    AVFormatContext *s = avformat_alloc_context();
+    MOVMuxContext *mov = av_mallocz(sizeof(*mov));
+    MOVTrack *trk = av_mallocz(sizeof(*trk));
+    AVStream *st;
+    AVPacket test_pkt = { 0 };
+    uint8_t data = 0;
+    uint8_t *buf = NULL;
+    int old_log_level, ret;
+
+    check(s && mov && trk, "could not allocate AVIF first-packet test state");
+    if (!s || !mov || !trk)
+        goto cleanup;
+
+    st = avformat_new_stream(s, NULL);
+    check(st != NULL, "could not allocate AVIF first-packet test stream");
+    if (!st)
+        goto cleanup;
+
+    ret = avio_open_dyn_buf(&s->pb);
+    check(ret >= 0, "could not allocate AVIF first-packet test output");
+    if (ret < 0)
+        goto cleanup;
+
+    s->priv_data = mov;
+    st->priv_data = trk;
+    mov->mode = MODE_AVIF;
+    trk->mode = MODE_AVIF;
+    trk->st = st;
+    trk->par = st->codecpar;
+    trk->start_dts = AV_NOPTS_VALUE;
+    trk->dts_shift = AV_NOPTS_VALUE;
+    trk->hint_track = -1;
+    st->codecpar->codec_type = AVMEDIA_TYPE_VIDEO;
+    st->codecpar->codec_id = AV_CODEC_ID_RAWVIDEO;
+
+    test_pkt.data = &data;
+    test_pkt.size = 1;
+    test_pkt.stream_index = 0;
+    test_pkt.pts = test_pkt.dts = 0;
+    test_pkt.duration = 1;
+
+    old_log_level = av_log_get_level();
+    av_log_set_level(AV_LOG_QUIET);
+    ret = ff_mov_write_packet(s, &test_pkt);
+    av_log_set_level(old_log_level);
+    check(ret == AVERROR_INVALIDDATA,
+          "AVIF accepted a non-key first video packet: %d", ret);
+
+cleanup:
+    if (mov && mov->mdat_buf) {
+        avio_close_dyn_buf(mov->mdat_buf, &buf);
+        mov->mdat_buf = NULL;
+    }
+    av_freep(&buf);
+    if (trk && trk->mdat_buf) {
+        avio_close_dyn_buf(trk->mdat_buf, &buf);
+        trk->mdat_buf = NULL;
+    }
+    av_freep(&buf);
+    if (s && s->pb) {
+        avio_close_dyn_buf(s->pb, &buf);
+        s->pb = NULL;
+    }
+    av_freep(&buf);
+    if (trk) {
+        av_freep(&trk->cluster);
+        av_freep(&trk->vos_data);
+    }
+    if (s && s->nb_streams)
+        s->streams[0]->priv_data = NULL;
+    if (s)
+        s->priv_data = NULL;
+    av_free(trk);
+    av_free(mov);
+    avformat_free_context(s);
+}
